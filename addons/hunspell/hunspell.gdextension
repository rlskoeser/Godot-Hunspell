[configuration]

entry_symbol = "hunspell_library_init"
compatibility_minimum = "4.2"

[libraries]

windows.debug.x86_64 = "res://addons/hunspell/bin/hunspell.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/hunspell/bin/hunspell.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/hunspell/bin/libhunspell.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/hunspell/bin/libhunspell.linux.template_release.x86_64.so"
macos.debug = "res://addons/hunspell/bin/libhunspell.macos.template_debug.universal.dylib"
macos.release = "res://addons/hunspell/bin/libhunspell.macos.template_release.universal.dylib"
web.debug.wasm32 = "res://addons/hunspell/bin/libhunspell.web.template_debug.wasm32.wasm"
web.release.wasm32 = "res://addons/hunspell/bin/libhunspell.web.template_release.wasm32.wasm"
android.debug.arm64 = "res://addons/hunspell/bin/libhunspell.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/hunspell/bin/libhunspell.android.template_release.arm64.so"

[dependencies]

windows.debug.x86_64 = {}
windows.release.x86_64 = {}
linux.debug.x86_64 = {}
linux.release.x86_64 = {}
macos.debug = {}
macos.release = {}
web.debug.wasm32 = {}
web.release.wasm32 = {}
android.debug = {}
android.release = {}
